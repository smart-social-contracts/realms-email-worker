# Email provider: 'resend' (recommended) or 'smtp'
EMAIL_PROVIDER=resend

# Resend settings (recommended for deliverability)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SMTP fallback settings (only used when EMAIL_PROVIDER=smtp)
SMTP_HOST=mail.privateemail.com
SMTP_PORT=587
SMTP_USER=admin@realmsgos.dev
SMTP_PASSWORD=changeme

# Default From address. Use a subdomain like notify.realmsgos.org
ALERT_EMAIL_FROM=noreply@notify.realmsgos.dev

# Realm to poll for pending emails
REALM_CANISTER_ID=aaaaa-aa
DFX_NETWORK=local
DFX_IDENTITY=

# Worker behavior
EMAIL_POLL_INTERVAL_SECONDS=60
MAX_EMAILS_PER_POLL=50
EMAIL_SEND_DELAY_SECONDS=0.5

# Optional: override the dfx command template if you use a custom IC agent
# EMAIL_WORKER_DFX_CALL_TEMPLATE=dfx {identity} canister --network {network} call {canister}

# Local suppression list for hard-bounced addresses
EMAIL_SUPPRESS_LIST_PATH=./suppress_list.txt
