# SMTP credentials — use Namecheap Private Email or any transactional provider.
SMTP_HOST=mail.privateemail.com
SMTP_PORT=587
SMTP_USER=admin@realmsgos.dev
SMTP_PASSWORD=changeme
ALERT_EMAIL_FROM=admin@realmsgos.dev

# Realm to poll for pending emails.
REALM_CANISTER_ID=aaaaa-aa
DFX_NETWORK=local
DFX_IDENTITY=

# How often (in seconds) the worker asks the canister for pending emails.
EMAIL_POLL_INTERVAL_SECONDS=60

# Optional: override the dfx command template if you use a custom IC agent.
# EMAIL_WORKER_DFX_CALL_TEMPLATE=dfx {identity} canister --network {network} call {canister}
